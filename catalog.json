            "rules": [
              {
                "type": "apk",
                "packageName": "com.drbeef.doom3quest"
              }
            ]
          },
          "install": {
            "steps": [
              {
                "kind": "apk",
                "fileName": "Doom3Quest-1.4.8.2-arm64.apk",
                "assetPattern": "Doom3Quest-*-arm64.apk",
                "downloadUrl": "https://github.com/LibreHaptics/standalone-Doom3Quest/releases/download/v1.4.8.2/Doom3Quest-1.4.8.2-arm64.apk",
                "sha256": "d95100db1cade7831f95e30cff13d94b7c517cc740d4f2a8451db4cf410b9e52",
                "requiresUninstallOnSignatureMismatch": true,
                "version": "1.4.8.2"
              }
            ]
          },
          "uninstall": {
            "uninstallApk": true,
            "removeLocalPack": true,
            "deleteTrackedFiles": true,
            "preservePaths": [
              "/sdcard/Doom3Quest"
            ]
          }
        }
      }
    },
